<figure class="software-example"><figcaption>{{ translate("Example · Python") }}</figcaption>
<p class="example-note">{{ translate("Install with") }} <code>pip install cpg2py</code>{{ translate(". Use tab-delimited") }} <code>nodes.csv</code> {{ translate("and") }} <code>rels.csv</code> {{ translate("exports.") }}</p>
<pre><code class="language-python">from pathlib import Path
from cpg2py import cpg_graph

graph = cpg_graph(Path(&quot;nodes.csv&quot;), Path(&quot;rels.csv&quot;))
for node in graph.nodes(lambda n: n.type == &quot;Function&quot;):
    print(node.name)</code></pre>
<p class="example-note">{{ translate("Prints the function names in the supplied graph.") }}</p></figure>
</div></details></article>
