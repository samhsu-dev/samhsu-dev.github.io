<!-- Source: templates/index.html.j2. Render with Jinja and the bibliometrics JSON data. -->
<html lang="{{ locale }}"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="description" content="{{ translate("Yichao Xu, JHU computer science PhD candidate studying program analysis and agentic security.") }}"><title>{{ translate("Yichao Xu · Software Security Research") }}</title><link rel="alternate" type="text/plain" href="llms.txt" title="{{ translate("Agent-readable profile") }}"><link rel="stylesheet" href="home.css?v=research"><link rel="stylesheet" href="cobra-demo.css"><link rel="alternate" hreflang="en" href="index.html"><link rel="alternate" hreflang="zh-Hans" href="index-zh.html"></head>
<body><div class="site-wrap">
<header class="site-header"><a class="wordmark" href="#top">Yichao Xu</a><nav aria-label="{{ translate("Main navigation") }}"><a href="#research">{{ translate("Research") }}</a><a href="#projects">{{ translate("Software") }}</a><a href="#education">{{ translate("Education") }}</a><a href="#experience">{{ translate("Experience") }}</a><a href="#teaching">{{ translate("Teaching") }}</a><span class="language-switch" role="group" aria-label="{{ translate('Language') }}"><a href="index.html" lang="en" hreflang="en"{% if locale == 'en' %} aria-current="page"{% endif %}>English</a><span aria-hidden="true">/</span><a href="index-zh.html" lang="zh-Hans" hreflang="zh-Hans"{% if locale == 'zh-Hans' %} aria-current="page"{% endif %}>中文</a></span></nav></header>
<main id="top">
